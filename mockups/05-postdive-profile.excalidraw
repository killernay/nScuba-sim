    {"type":"text","id":"stats_data","x":1340,"y":255,"width":500,"height":280,"text":"Max Depth          25.1 m\nAvg Depth          18.4 m\nDive Time          38:42\n\nGas Used           120 bar (200 > 80)\nSAC Rate           14.2 L/min\nGas Mix            EAN32\n\nNDL at Surface     8 min remaining\nSafety Stop        3:00 completed\nAscent Rate Max    12 m/min\n\nCNS End            22%\nPPO2 Max           1.18 bar\n\nBWRAF Score        5/5 correct\nViolations         0","originalText":"Max Depth          25.1 m\nAvg Depth          18.4 m\nDive Time          38:42\n\nGas Used           120 bar (200 > 80)\nSAC Rate           14.2 L/min\nGas Mix            EAN32\n\nNDL at Surface     8 min remaining\nSafety Stop        3:00 completed\nAscent Rate Max    12 m/min\n\nCNS End            22%\nPPO2 Max           1.18 bar\n\nBWRAF Score        5/5 correct\nViolations         0","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":80,"angle":0,"seed":4007,"version":1,"versionNonce":4008,"isDeleted":false,"groupIds":["stats"],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

