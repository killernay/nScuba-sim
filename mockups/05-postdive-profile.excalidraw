    {"type":"text","id":"feedback_text","x":80,"y":700,"width":760,"height":120,"text":"Good dive! Your descent was well-controlled with proper equalization.\nSAC rate of 14.2 L/min is average — try relaxing your breathing\nfor better gas efficiency.\nSafety stop completed at correct depth. Well done!\n\nTip: Your ascent rate peaked at 12 m/min between 15-10m.\nTry to keep it below 9 m/min for optimal safety.","originalText":"Good dive! Your descent was well-controlled with proper equalization.\nSAC rate of 14.2 L/min is average — try relaxing your breathing\nfor better gas efficiency.\nSafety stop completed at correct depth. Well done!\n\nTip: Your ascent rate peaked at 12 m/min between 15-10m.\nTry to keep it below 9 m/min for optimal safety.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":70,"angle":0,"seed":5005,"version":1,"versionNonce":5006,"isDeleted":false,"groupIds":["feedback"],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

